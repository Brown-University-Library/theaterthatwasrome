## Environment-file example -------------------------------------------------
## Copy this file to `../.env` from the repository root, then replace every
## example value needed by the selected settings module.
## Never commit an environment file containing real credentials.


## Local development ---------------------------------------------------------
## These are the only variables required by `uv run ./manage.py runserver`.

DJANGO_SETTINGS_MODULE="config.settings.local"
LOG_DIR="../logs"
ROME_BDR_SERVER="bdr-dev.univ.edu"
ROME_PID_PREFIX="test"
ROME_BDR_IDENTITY="FOO-not-relevant for-local-writes"
ROME_BDR_AUTH_CODE="BAR-not-relevant for-local-writes"


## Development/staging server reference -------------------------------------
## This repository calls the development-server settings "staging".
## The values below are examples only. Define them in that server's protected
## environment; do not uncomment them for local development.

# DJANGO_SETTINGS_MODULE="config.settings.staging"
# LOG_DIR="/var/log/rome"
# ROME_BDR_SERVER="bdr-dev.univ.edu"
# ROME_PID_PREFIX="test"
# ROME_BDR_IDENTITY="replace-with-dev-bdr-identity"
# ROME_BDR_AUTH_CODE="replace-with-dev-bdr-auth-code"
# DB_NAME="rome_dev"
# DB_USER="rome_dev_user"
# DB_PASSWORD="replace-with-dev-database-password"
# DB_HOST="db-dev.univ.edu"
# DB_PORT="3306"
# SECRET_KEY="replace-with-long-random-dev-django-secret"
# EMAIL_HOST="smtp.univ.edu"
# ALLOWED_HOST="rome-dev.univ.edu"
# SERVER_EMAIL="rome-dev@univ.edu"
# TURNSTILE_SITE_KEY="replace-with-dev-turnstile-site-key"
# TURNSTILE_SECRET_KEY="replace-with-dev-turnstile-secret-key"
# TURNSTILE_API_URL="https://challenges.cloudflare.com/turnstile/v0/siteverify"
# TURNSTILE_API_TIMEOUT="5"
# TURNSTILE_EMAIL="rome-help@univ.edu"
# TURNSTILE_SESSION_EXPIRY_MINUTES="60"
# TURNSTILE_ALLOWED_IPS_JSON='["192.0.2.10", "198.51.100.0/24"]'


## Production server reference ----------------------------------------------
## The values below are examples only. Define them in the production server's
## protected environment; do not uncomment them for local development.
## Production ALLOWED_HOSTS is defined directly in config/settings/production.py.

# DJANGO_SETTINGS_MODULE="config.settings.production"
# LOG_DIR="/var/log/rome"
# ROME_BDR_SERVER="bdr.univ.edu"
# ROME_PID_PREFIX="bdr"
# ROME_BDR_IDENTITY="replace-with-production-bdr-identity"
# ROME_BDR_AUTH_CODE="replace-with-production-bdr-auth-code"
# ADMINS_JSON='[["Site Admin", "admin@univ.edu"]]'
# DB_NAME="rome_production"
# DB_USER="rome_production_user"
# DB_PASSWORD="replace-with-production-database-password"
# DB_HOST="db.univ.edu"
# DB_PORT="3306"
# SECRET_KEY="replace-with-long-random-production-django-secret"
# EMAIL_HOST="smtp.univ.edu"
# SERVER_EMAIL="rome@univ.edu"
# TURNSTILE_SITE_KEY="replace-with-production-turnstile-site-key"
# TURNSTILE_SECRET_KEY="replace-with-production-turnstile-secret-key"
# TURNSTILE_API_URL="https://challenges.cloudflare.com/turnstile/v0/siteverify"
# TURNSTILE_API_TIMEOUT="5"
# TURNSTILE_EMAIL="rome-help@univ.edu"
# TURNSTILE_SESSION_EXPIRY_MINUTES="60"
# TURNSTILE_ALLOWED_IPS_JSON='["192.0.2.10", "198.51.100.0/24"]'
